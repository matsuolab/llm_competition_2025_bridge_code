# ===========================================
# v1 No Seed Configuration (Local Data Generation)
# ===========================================

# ===========================================
# Model Configuration
# ===========================================
MODEL_PATH=/home/Competition2025/P05/shareP05/models/Qwen3-235B-A22B
MODEL_CACHE_DIR=/home/Competition2025/P05/shareP05/models

# ===========================================
# vLLM Settings
# ===========================================
TENSOR_PARALLEL_SIZE=8
GPU_MEMORY_UTILIZATION=0.95
DTYPE=bfloat16
MAX_MODEL_LEN=16384

# ===========================================
# Generation Settings
# ===========================================
# Number of problem-solution pairs to generate
NUM_ITERATIONS=100
NUM_COT_CANDIDATES=10
COT_TEMPERATURE=0.6
USE_MAJORITY_VOTING=true

# ===========================================
# Output Settings
# ===========================================
OUTPUT_DIR=/home/Competition2025/P05/shareP05/data_generation/data_generation_output/v1_no_seed

# ===========================================
# Development Settings
# ===========================================
DEBUG=false
MAX_RETRIES=3
TIMEOUT_SECONDS=600