# ===========================================
# v3 Seed with RAG Configuration (Local Data Generation)
# ===========================================

# ===========================================
# Model Configuration
# ===========================================
MODEL_PATH=/home/Competition2025/P05/shareP05/models/Qwen3-235B-A22B
MODEL_CACHE_DIR=/home/Competition2025/P05/shareP05/models

# ===========================================
# vLLM Settings
# ===========================================
TENSOR_PARALLEL_SIZE=8
GPU_MEMORY_UTILIZATION=0.95
DTYPE=bfloat16
MAX_MODEL_LEN=16384

# ===========================================
# Seed Data Configuration
# ===========================================
SEED_FILE_PATH=/home/Competition2025/P05/shareP05/seed_data/math_problems.jsonl
SEED_BATCH_SIZE=10

# ===========================================
# RAG Configuration (Local)
# ===========================================
USE_RAG=true
RAG_INDEX_PATH=/home/Competition2025/P05/shareP05/rag_indexes/math_index.faiss
RAG_METADATA_PATH=/home/Competition2025/P05/shareP05/rag_indexes/math_metadata.json
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.4
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ===========================================
# Generation Settings
# ===========================================
PROBLEMS_PER_SEED=5
NUM_COT_CANDIDATES=10
COT_TEMPERATURE=0.6
USE_MAJORITY_VOTING=true

# ===========================================
# Output Settings
# ===========================================
OUTPUT_DIR=/home/Competition2025/P05/shareP05/data_generation/data_generation_output/v3_seed_with_rag

# ===========================================
# Development Settings
# ===========================================
DEBUG=false
MAX_RETRIES=3
TIMEOUT_SECONDS=600