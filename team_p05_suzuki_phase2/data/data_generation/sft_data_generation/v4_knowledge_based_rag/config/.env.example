# ===========================================
# v4 Knowledge-Based RAG Configuration
# ===========================================

# ===========================================
# EXECUTION MODE CONFIGURATION
# ===========================================
# Single-node multiprocessing execution
DEPLOYMENT_MODE=single

# Model Configuration
MODEL_PATH=/home/Competition2025/P05/shareP05/models/Qwen3-235B-A22B-Thinking-2507
MODEL_CACHE_DIR=/home/Competition2025/P05/shareP05/models

# vLLM Settings
TENSOR_PARALLEL_SIZE=8
GPU_MEMORY_UTILIZATION=0.95
DTYPE=bfloat16
MAX_MODEL_LEN=16384

# ===========================================
# Multiprocessing Configuration
# ===========================================
USE_REMOTE_RAG=false

# Knowledge RAG Settings
USE_KNOWLEDGE_RAG=true
# Use Hugging Face built index (from team-suzuki/RAG_0912)
KNOWLEDGE_INDEX_PATH=/home/Competition2025/P05/shareP05/data_generation/knowledge_indexes_hf/knowledge_index.faiss
KNOWLEDGE_METADATA_PATH=/home/Competition2025/P05/shareP05/data_generation/knowledge_indexes_hf/knowledge_metadata.json
KNOWLEDGE_TOP_K=5
KNOWLEDGE_SIMILARITY_THRESHOLD=0.4
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Generation Settings
PROBLEMS_PER_SEED=5
NUM_COT_CANDIDATES=10
COT_TEMPERATURE=0.6
USE_MAJORITY_VOTING=true

# Difficulty Settings (intermediate, advanced, expert, research)
DEFAULT_DIFFICULTY=expert

# Output Settings
OUTPUT_DIR=/home/Competition2025/P05/shareP05/data_generation/data_generation_output/v4_knowledge_based

# ===========================================
# ArXiv Scraping Configuration
# ===========================================
# Number of papers to scrape
ARXIV_MAX_PAPERS=100
# Whether to filter for commercial use (true/false)
ARXIV_COMMERCIAL_USE=true
# Output directory for scraped papers
ARXIV_OUTPUT_DIR=/home/Competition2025/P05/shareP05/data_generation/arxiv_papers
# Use multi-field distribution for balanced scraping
ARXIV_USE_MULTI_FIELD=true

# ===========================================
# Hugging Face Configuration
# ===========================================
# HF_TOKEN: Your Hugging Face access token for downloading datasets
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# HF_DATASET_NAME: The Hugging Face dataset to use for knowledge index
# Format: organization/dataset_name
HF_DATASET_NAME=team-suzuki/RAG_0912

# KNOWLEDGE_INDEX_OUTPUT_DIR: Directory where the built FAISS index will be saved
KNOWLEDGE_INDEX_OUTPUT_DIR=/home/Competition2025/P05/shareP05/data_generation/knowledge_indexes

# EMBEDDING_MODEL: The embedding model to use for creating document embeddings
# Recommended: BAAI/bge-large-en-v1.5 (high quality embeddings)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# DEVICE: Device to use for embedding generation (cuda or cpu)
# Use 'cuda' if GPU is available for faster processing
DEVICE=cuda

# BATCH_SIZE: Number of documents to process at once
# Adjust based on available GPU memory
BATCH_SIZE=32
