# SFT Data Generation Configuration

# API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Model Backend Selection
USE_VLLM=false  # Set to "true" to use vLLM, "false" for API mode
USE_LOCAL_DEEPSEEK=false  # Set to "true" for local DeepSeek model

# Model Paths and Settings
DEEPSEEK_MODEL_PATH=/home/Competition2025/P05/shareP05/models/DeepSeek-R1-0528
HF_TOKEN=  # Hugging Face token for model download if needed
MODEL_CACHE_DIR=/home/Competition2025/P05/shareP05/models
HF_MODEL_ID=deepseek-ai/DeepSeek-R1-0528

# vLLM Settings
TENSOR_PARALLEL_SIZE=8  # Number of GPUs for tensor parallelism
GPU_MEMORY_UTILIZATION=0.9  # GPU memory usage (0.0-1.0)
QUANTIZATION_METHOD=fp8  # Options: none, fp8, awq, gptq
DTYPE=float16  # Options: float16, bfloat16, float32
TRUST_REMOTE_CODE=true
MAX_MODEL_LEN=65536  # Max model length

# Generation Settings
NUM_ITERATIONS=1  # Number of items to generate
CONCURRENT_REQUESTS=2  # Number of concurrent generation requests
DIFFICULTY_LEVEL=5  # 1-7 (1=Very Easy, 7=Expert Level)
MODEL_NAME_GENERATOR=deepseek-reasoner  # Model for generating questions
MODEL_NAME_SOLVER=deepseek-reasoner  # Model for solving questions

# Multi-CoT Settings
NUM_COT_CANDIDATES=16  # Number of CoT candidates to generate per problem
COT_TEMPERATURE=0.6  # Temperature for CoT generation
USE_MAJORITY_VOTING=true  # Enable majority voting for answer correction

# LoRA Settings (Optional)
USE_LORA=false
LORA_ADAPTER_PATH=
LORA_ADAPTER_NAME=