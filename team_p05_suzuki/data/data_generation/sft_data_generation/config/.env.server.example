# vLLM Settings (GPU usage on server)
USE_VLLM=true  # Enable vLLM backend for GPU inference
USE_LOCAL_DEEPSEEK=true  # Use local DeepSeek model instead of API

# Model Configuration
DEEPSEEK_MODEL_PATH=/home/Competition2025/P05/shareP05/models/DeepSeek-R1-0528-Qwen3-8B
MODEL_CACHE_DIR=/home/Competition2025/P05/shareP05/models
HF_TOKEN=your_hf_token_here  # HuggingFace token (required for private models)
HF_MODEL_ID=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B  # HuggingFace model ID for download

# GPU Settings (number of GPUs to use from 8x H100)
TENSOR_PARALLEL_SIZE=8  # Number of GPUs for tensor parallelism
GPU_MEMORY_UTILIZATION=0.9  # GPU memory usage limit (0.0-1.0)
QUANTIZATION_METHOD=  # Options: "awq", "gptq", or leave empty for no quantization
DTYPE=float16  # Data type for model weights
TRUST_REMOTE_CODE=true  # Allow custom model code execution

# vLLM Advanced Settings
MAX_MODEL_LEN=65536  # Maximum model context length

# LoRA Settings (if using LoRA adapters)
USE_LORA=false  # Enable LoRA adapter support
LORA_ADAPTER_PATH=  # Path to LoRA adapter weights
LORA_ADAPTER_NAME=  # Name of the LoRA adapter

# API Mode Settings (if not using vLLM)
DEEPSEEK_API_KEY=your_api_key_here

# Generation Settings
NUM_ITERATIONS=5  # Number of problem-solution pairs to generate
CONCURRENT_REQUESTS=5  # Number of concurrent generation requests
DIFFICULTY_LEVEL=5  # Problem difficulty (1-7)
NUM_COT_CANDIDATES=5  # Number of CoT candidates per problem

# Model Names (for API mode)
MODEL_NAME_GENERATOR=deepseek-reasoner
MODEL_NAME_SOLVER=deepseek-reasoner